digraph Modules {
    rankdir=LR;
    node [shape=note, fontname="Helvetica", fontsize=11, style=filled, fillcolor=lightyellow];
    edge [fontname="Helvetica", fontsize=9, color=gray];

    config [label="config.h"];
    vector [label="vector.h"];
    fish [label="fish.h"];
    fish_ctrl [label="fish_controller.h"];
    shark [label="shark.h"];
    world [label="world.h"];
    mj [label="mj.h"];
    render [label="render_sdl.h"];
    game [label="game.h"];

    fish -> config;
    fish -> vector;
    fish_ctrl -> config;
    fish_ctrl -> fish;
    fish_ctrl -> vector;
    shark -> config;
    shark -> vector;
    world -> fish;
    world -> shark;
    world -> vector;
    mj -> fish;
    mj -> fish_ctrl;
    mj -> world;
    render -> fish;
    render -> shark;
    render -> world;
    game -> render;
    game -> world;
}
