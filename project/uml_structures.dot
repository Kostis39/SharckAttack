digraph Structures {
    rankdir=TB;
    node [shape=record, fontname="Helvetica", fontsize=10];

    Vector [label="{Vector|  x : float\l  y : float\l|  Vector_init()\l  Vector_add(a,b)\l  Vector_sub(a,b)\l  Vector_scale(v,k)\l  Vector_length(v)\l  Vector_distance(a,b)\l  Vector_normalize(v)\l  Vector_limit(v,max)\l  Vector_angle(a,b)\l}"];

    Fish [label="{Fish|  position : Vector\l  velocity : Vector\l  is_alive : bool\l  radius_separation : float\l  radius_alignement : float\l  radius_cohesion : float\l  vision_angle : float\l|  Fish_create_random_pos(w,h)\l  Fish_create_random_array(nb,w,h)\l  Fish_copy_array(arr,nb)\l  Fish_destroy_array(arr)\l}"];

    Shark [label="{Shark|  pos : Vector\l  velocity : Vector\l  player : bool\l|  Shark_createRandom(w,h)\l  Shark_copy(dest,src)\l  Shark_destroy(s)\l  Is_player(s)\l}"];

    FishPerception [label="{FishPerception|  self : Fish\l  neighbor_separation : Fish*\l  nb_sep : int\l  neighbor_alignment : Fish*\l  nb_align : int\l  neighbor_cohesion : Fish*\l  nb_cohes : int\l  shark_visible : bool\l  shark_position : Vector\l  shark_velocity : Vector\l  width : int\l  height : int\l}"];

    World [label="{World|  width : int\l  height : int\l  fishes : Fish*\l  nb_fish : int\l  shark : Shark*\l|  World_init(w,h,nb)\l  World_destroy(w)\l  World_update(w,tmp)\l}"];

    SDLDisplay [label="{SDLDisplay|  window : SDL_Window*\l  renderer : SDL_Renderer*\l}"];

    Game [label="{Game|  world : World\l  display : SDLDisplay\l  time : float\l  paused : bool\l  fish_eaten : int\l|  Game_init(g,w,h,nb)\l  Game_step(g)\l  Game_pause(g)\l  Game_run(g)\l  Game_destroy(g)\l}"];

    World -> Fish [arrowhead=crow];
    World -> Shark [arrowhead=crow];
    Game -> World [arrowhead=crow];
    Game -> SDLDisplay [arrowhead=crow];
    FishPerception -> Fish [arrowhead=odiamond];
    Fish -> Vector [style=dashed];
    Shark -> Vector [style=dashed];
}
